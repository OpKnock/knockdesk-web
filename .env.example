# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://knockdesk.app
# Optional: form backend (Formspree or Web3Forms endpoint). Empty = contact form opens the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=
# Optional: cookieless analytics via Plausible. Empty = no analytics script loads.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
